{
  "compilerOptions": {
    "target": "ES6",
    "module": "none",
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2016", "DOM"]
  },
  "include": [
    "script.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
